<Application
    x:Class="Freely.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="FreelyFontFamily">Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
            <Color x:Key="FreelyAccentColor">#FF0A84FF</Color>
            <SolidColorBrush x:Key="FreelyAccentBrush" Color="{StaticResource FreelyAccentColor}" />
            <SolidColorBrush x:Key="FreelyAgentMessageBrush" Color="#147D7D87" />
            <SolidColorBrush x:Key="FreelyUserMessageBrush" Color="#FF0A84FF" />
            <SolidColorBrush x:Key="FreelyWorkingTextBrush" Color="#FF8E8E93" />
            <SolidColorBrush x:Key="FreelyCompleteTextBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

            <Style x:Key="ComposerButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{StaticResource FreelyFontFamily}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
