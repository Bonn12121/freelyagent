<Page
    x:Class="Freely.App.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Freely.App.ViewModels"
    Background="Transparent"
    FontFamily="{StaticResource FreelyFontFamily}">
    <Page.Resources>
        <Storyboard x:Key="WorkingPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="StatusDot" Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.55" />
        </Storyboard>
        <Storyboard x:Key="BrowserGlowPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="BrowserGlow" Storyboard.TargetProperty="Opacity" From="0.58" To="0.95" Duration="0:0:1.8" />
        </Storyboard>
        <Style x:Key="ChatToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualPrimaryBrush" Value="Transparent" />
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters><Setter Target="ButtonChrome.Background" Value="#18FFFFFF" /></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters><Setter Target="ButtonChrome.Background" Value="#30FFFFFF" /></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters><Setter Target="ButtonChrome.Opacity" Value="0.4" /></VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="ButtonChrome" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="15">
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChatMenuRowButtonStyle" TargetType="Button" BasedOn="{StaticResource ChatToolbarButtonStyle}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters><Setter Target="SendChrome.Opacity" Value="0.9" /></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters><Setter Target="SendChrome.Opacity" Value="0.78" /></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters><Setter Target="SendChrome.Opacity" Value="0.45" /></VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="SendChrome" Background="{TemplateBinding Background}" CornerRadius="16">
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" Opacity="0.72" VerticalAlignment="Center" />
            </StackPanel>

            <InfoBar x:Name="ControlNotice" Visibility="Collapsed" IsOpen="False" IsClosable="False" />
        </Grid>

        <ListView
            x:Name="MessageList"
            Grid.Row="1"
            ItemsSource="{x:Bind Messages}"
            SelectionMode="None"
            Padding="22,4,22,18"
            HorizontalContentAlignment="Stretch">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                    <ContentThemeTransition VerticalOffset="12" />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:MessageItem">
                    <Grid Padding="6,4" HorizontalAlignment="Stretch">
                        <Border
                            MaxWidth="{x:Bind MaxWidth}"
                            Padding="{x:Bind Padding}"
                            CornerRadius="{x:Bind CornerRadius}"
                            Background="{x:Bind Background}"
                            HorizontalAlignment="{x:Bind Alignment}"
                            Opacity="{x:Bind Opacity, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Content, Mode=OneWay}" Foreground="{x:Bind Foreground, Mode=OneWay}" FontSize="{x:Bind FontSize}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="2" Margin="28,8,28,24" Padding="12,8,8,8" CornerRadius="17" BorderThickness="0" Background="#FF2A2A2A">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="PromptBox"
                    Grid.ColumnSpan="6"
                    PlaceholderText="Ask Anything. Build Anything. Freely."
                    BorderThickness="0"
                    Background="Transparent"
                    CornerRadius="0"
                    Padding="0,4"
                    FocusVisualPrimaryBrush="Transparent"
                    FocusVisualSecondaryBrush="Transparent"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MaxHeight="132"
                    MinHeight="46"
                    VerticalContentAlignment="Center"
                    TextChanged="OnPromptTextChanged"
                    PreviewKeyDown="OnPromptPreviewKeyDown">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                    </TextBox.Resources>
                </TextBox>

                <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource ChatToolbarButtonStyle}" AutomationProperties.Name="Attach files" ToolTipService.ToolTip="Attach files (coming next)">
                    <FontIcon Glyph="&#xE710;" FontSize="16" />
                </Button>

                <Button x:Name="PermissionButton" Grid.Row="1" Grid.Column="1" Margin="4,0,0,0" Style="{StaticResource ChatToolbarButtonStyle}" Click="OnPermissionButtonClicked" AutomationProperties.Name="Choose approval mode">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon x:Name="PermissionButtonIcon" Glyph="&#xEA18;" FontSize="13" />
                        <TextBlock x:Name="PermissionButtonText" Text="Ask for approval" FontSize="12" />
                        <FontIcon Glyph="&#xE70D;" FontSize="8" Opacity="0.65" />
                    </StackPanel>
                </Button>

                <Button x:Name="ModelButton" Grid.Row="1" Grid.Column="3" Margin="4,0,1,0" Padding="10,0" Background="#20FFFFFF" Style="{StaticResource ChatToolbarButtonStyle}" HorizontalAlignment="Right" Click="OnModelButtonClicked" AutomationProperties.Name="Choose model">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock x:Name="ModelButtonText" Text="Demo" FontSize="12" FontWeight="Bold" />
                        <FontIcon Glyph="&#xE70D;" FontSize="8" Opacity="0.65" />
                    </StackPanel>
                </Button>

                <Button x:Name="VoiceButton" Grid.Row="1" Grid.Column="4" Style="{StaticResource ChatToolbarButtonStyle}" Click="OnVoiceClicked" AutomationProperties.Name="Dictate message" ToolTipService.ToolTip="Speak to type">
                    <FontIcon Glyph="&#xE720;" FontSize="15" />
                </Button>

                <Button x:Name="SendButton" Grid.Row="1" Grid.Column="5" Margin="3,0,0,0" Style="{StaticResource SendButtonStyle}" Click="OnSendClicked" Background="#FF3A3A3C" Foreground="White" AutomationProperties.Name="Send message">
                    <Grid Width="17" Height="17">
                        <Path x:Name="SendIcon" Data="M8.5,14 L8.5,3 M4.2,7.3 L8.5,3 L12.8,7.3" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <Border x:Name="StopIcon" Width="8" Height="8" CornerRadius="2.25" Background="White" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <Button Visibility="Collapsed" IsTabStop="False">
        <Button.Flyout>
        <Flyout x:Name="PermissionFlyout" Placement="TopEdgeAlignedLeft" Closed="OnPermissionFlyoutClosed">
            <Flyout.FlyoutPresenterStyle>
                <Style TargetType="FlyoutPresenter">
                    <Setter Property="IsDefaultShadowEnabled" Value="False" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="CornerRadius" Value="0" />
                </Style>
            </Flyout.FlyoutPresenterStyle>
            <Border Width="410" Padding="10" CornerRadius="16" BorderThickness="1" BorderBrush="#14FFFFFF" Background="#FF2B2B2D">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="How should Freely actions be approved?" Margin="8,2,8,7" Foreground="#FFA8A8AD" FontSize="12" />
                    <Button Grid.Row="1" Style="{StaticResource ChatMenuRowButtonStyle}" Click="OnAskApprovalClicked">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE890;" FontSize="14" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="Ask for approval" FontWeight="SemiBold" /><TextBlock Text="Always ask before edits, internet actions, or app control" FontSize="11" Foreground="#FFA8A8AD" /></StackPanel>
                            <Viewbox x:Name="AskApprovalCheck" Grid.Column="2" Width="14" Height="14" VerticalAlignment="Center">
                                <Path Data="M2,7 L5.3,10.2 L12,3" Stroke="#FFA8A8AD" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Viewbox>
                        </Grid>
                    </Button>
                    <Button Grid.Row="2" Style="{StaticResource ChatMenuRowButtonStyle}" Click="OnApproveForMeClicked">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;" FontSize="14" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="Approve for me" FontWeight="SemiBold" /><TextBlock Text="Only ask for potentially unsafe actions" FontSize="11" Foreground="#FFA8A8AD" /></StackPanel>
                            <Viewbox x:Name="ApproveForMeCheck" Grid.Column="2" Width="14" Height="14" VerticalAlignment="Center">
                                <Path Data="M2,7 L5.3,10.2 L12,3" Stroke="#FF34C759" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Viewbox>
                        </Grid>
                    </Button>
                    <Button Grid.Row="3" Style="{StaticResource ChatMenuRowButtonStyle}" Click="OnFullAccessClicked">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEA18;" FontSize="14" Foreground="#FF0A84FF" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="Full access" FontWeight="SemiBold" Foreground="#FF0A84FF" /><TextBlock Text="Unrestricted access to the internet and files on this computer" FontSize="11" Foreground="#FF0A84FF" /></StackPanel>
                            <Viewbox x:Name="FullAccessCheck" Grid.Column="2" Width="14" Height="14" VerticalAlignment="Center">
                                <Path Data="M2,7 L5.3,10.2 L12,3" Stroke="#FF0A84FF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Viewbox>
                        </Grid>
                    </Button>
                </Grid>
            </Border>
        </Flyout>
        </Button.Flyout>
        </Button>

        <Button Visibility="Collapsed" IsTabStop="False">
        <Button.Flyout>
        <Flyout x:Name="ModelFlyout" Placement="TopEdgeAlignedRight" Closed="OnModelFlyoutClosed">
            <Flyout.FlyoutPresenterStyle>
                <Style TargetType="FlyoutPresenter">
                    <Setter Property="IsDefaultShadowEnabled" Value="False" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="CornerRadius" Value="0" />
                </Style>
            </Flyout.FlyoutPresenterStyle>
            <Border Width="230" Padding="0,9,0,8" CornerRadius="18" BorderThickness="1" BorderBrush="#14FFFFFF" Background="#FF2B2B2B">
                <StackPanel>
                    <Border Background="#FF343434" CornerRadius="12" Padding="9,7" Margin="9,0,9,0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Default" FontSize="13" FontWeight="Bold" Foreground="#FFF5F5F5" />
                            <TextBlock Text="Recommended selection of frontier&#x0a;models" FontSize="12" LineHeight="16" Foreground="#FF9B9B9B" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Rectangle Height="1" Fill="#17FFFFFF" Margin="12,10,12,6" />
                    <ScrollViewer
                        Width="228"
                        MaxHeight="300"
                        HorizontalScrollMode="Disabled"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="ModelOptions" Width="228" HorizontalAlignment="Stretch" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Flyout>
        </Button.Flyout>
        </Button>

        <Border
            x:Name="BrowserGlow"
            Grid.RowSpan="3"
            Width="578"
            Margin="9"
            HorizontalAlignment="Right"
            IsHitTestVisible="False"
            Opacity="0.9"
            Visibility="Collapsed"
            BorderThickness="9"
            CornerRadius="24">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#000A84FF" Offset="0" />
                    <GradientStop Color="#CC5E5CE6" Offset="0.22" />
                    <GradientStop Color="#FF0A84FF" Offset="0.5" />
                    <GradientStop Color="#CC64D2FF" Offset="0.76" />
                    <GradientStop Color="#000A84FF" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>

        <Border
            x:Name="BrowserPanel"
            Grid.RowSpan="3"
            Width="560"
            Margin="18"
            Padding="1"
            HorizontalAlignment="Right"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="#8A0A84FF"
            BorderThickness="1"
            CornerRadius="15"
            Visibility="Collapsed">
            <Border.Shadow><ThemeShadow /></Border.Shadow>
            <Border.Transitions>
                <TransitionCollection><ContentThemeTransition HorizontalOffset="64" /></TransitionCollection>
            </Border.Transitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="14,9" Background="#F018181A">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="BrowserControlTitle" Text="Freely Browser" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock x:Name="BrowserControlSubtitle" Text="Built-in browser" Foreground="#FF9A9AA0" FontSize="11" />
                    </StackPanel>
                    <Button Grid.Column="1" Width="34" Height="34" Padding="0" Margin="0,0,4,0" CornerRadius="8" Click="OnPopOutBrowserClicked" Background="Transparent" Foreground="White" AutomationProperties.Name="Open browser in resizable window" ToolTipService.ToolTip="Open in a resizable window">
                        <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                    </Button>
                    <Button Grid.Column="2" Width="34" Height="34" Padding="0" CornerRadius="8" Click="OnCloseBrowserClicked" Background="Transparent" Foreground="White" AutomationProperties.Name="Hide Freely Browser">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
                <WebView2 x:Name="AgentBrowser" Grid.Row="1" />
            </Grid>
        </Border>
    </Grid>
</Page>
