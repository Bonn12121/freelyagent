<Page
    x:Class="Freely.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="28,20,36,36" Spacing="20" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel Spacing="3">
                <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Saved models stay together in one list. API keys are encrypted by Windows Credential Manager for your account." Opacity="0.65" TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar x:Name="SaveResult" IsOpen="False" IsClosable="True" />

            <Border Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="Saved models" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Every entry keeps its provider, endpoint, compatibility mode, and API key. Select an entry to edit it or make it active." Opacity="0.65" TextWrapping="Wrap" />
                    <ListView
                        x:Name="ModelList"
                        ItemsSource="{x:Bind Models}"
                        SelectionMode="Single"
                        SelectionChanged="OnModelSelectionChanged"
                        Width="520"
                        MaxHeight="220"
                        HorizontalAlignment="Left">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.62" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="New model" Click="OnNewModelClicked" />
                        <Button Content="Save model" Click="OnSaveModelClicked" Background="{StaticResource FreelyAccentBrush}" Foreground="White" />
                        <Button Content="Remove" Click="OnRemoveModelClicked" />
                    </StackPanel>
                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <TextBlock Text="Model details" FontWeight="SemiBold" />
                    <ComboBox x:Name="ProviderBox" Header="Provider" Width="320" HorizontalAlignment="Left" SelectionChanged="OnProviderChanged">
                        <ComboBoxItem Content="Demo (no model)" Tag="demo" />
                        <ComboBoxItem Content="Ollama / local compatible" Tag="ollama" />
                        <ComboBoxItem Content="OpenRouter" Tag="openrouter" />
                        <ComboBoxItem Content="xAI Console" Tag="xai" />
                        <ComboBoxItem Content="Google AI Studio" Tag="ai-studio" />
                        <ComboBoxItem Content="NVIDIA NIM" Tag="nvidia-nim" />
                        <ComboBoxItem Content="Custom OpenAI-compatible" Tag="openai-compatible" />
                    </ComboBox>
                    <TextBox x:Name="EndpointBox" Header="Base URL" Width="520" HorizontalAlignment="Left" PlaceholderText="http://localhost:11434/v1/" />
                    <TextBox x:Name="ModelBox" Header="Model ID" Width="520" HorizontalAlignment="Left" PlaceholderText="e.g. llama3.2" />
                    <PasswordBox x:Name="ApiKeyBox" Header="API key" Width="520" HorizontalAlignment="Left" PlaceholderText="Saved securely; leave blank to keep the existing key" />
                    <TextBlock x:Name="ApiKeySavedText" Text="No API key saved" FontSize="11" Opacity="0.65" />
                    <ToggleSwitch x:Name="ProtocolModeToggle" Header="Compatibility mode" OffContent="Native tool calling" OnContent="Text action protocol (for models without tools)" />
                    <ToggleSwitch x:Name="LocalOnlyToggle" Header="Local only" OffContent="Cloud providers allowed" OnContent="No cloud requests" Toggled="OnLocalOnlyToggled" />
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Voice" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="The composer microphone turns speech into text locally with Windows. Answers can also use an installed Windows voice." Opacity="0.65" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="VoiceResponsesToggle" Header="Speak answers aloud" OnContent="On" OffContent="Muted" Toggled="OnVoiceResponsesToggled" />
                    <ComboBox x:Name="VoiceBox" Header="Voice" Width="420" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Action permissions" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="These defaults apply before every tool execution. Destructive and administrator actions always ask." Opacity="0.65" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        x:Name="BrowserChoiceBox"
                        Header="Browser used by the agent"
                        Width="420"
                        HorizontalAlignment="Left" />
                    <TextBlock
                        x:Name="BrowserDiscoveryText"
                        Opacity="0.65"
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        x:Name="BrowserAlwaysAllowToggle"
                        Header="Always allow browser control"
                        OnContent="No approval between browser steps"
                        OffContent="Ask before browser actions" />
                    <ToggleSwitch
                        x:Name="AppControlAlwaysAllowToggle"
                        Header="Always allow app control"
                        OnContent="Open and control apps without approval pop-ups"
                        OffContent="Ask before app actions" />
                    <InfoBar
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Warning"
                        Title="Continuous AI control"
                        Message="When enabled, Freely may open, focus, click, type, scroll, and press keys in the selected browser or app without asking between steps. The glowing blue frame shows what it controls. Hold Left Shift to stop immediately." />
                    <Grid ColumnSpacing="20" RowSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="Read-only actions" VerticalAlignment="Center" />
                        <ComboBox x:Name="ReadOnlyPermission" Grid.Column="1" SelectedIndex="0"><x:String>Allow</x:String><x:String>Ask</x:String><x:String>Deny</x:String></ComboBox>
                        <TextBlock Grid.Row="1" Text="File and system changes" VerticalAlignment="Center" />
                        <ComboBox x:Name="WritePermission" Grid.Row="1" Grid.Column="1" SelectedIndex="1"><x:String>Allow</x:String><x:String>Ask</x:String><x:String>Deny</x:String></ComboBox>
                        <TextBlock Grid.Row="2" Text="Shell / unknown commands" VerticalAlignment="Center" />
                        <ComboBox x:Name="UnknownPermission" Grid.Row="2" Grid.Column="1" SelectedIndex="1"><x:String>Allow</x:String><x:String>Ask</x:String><x:String>Deny</x:String></ComboBox>
                        <TextBlock Grid.Row="3" Text="Destructive / administrator" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Chat approval mode" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Save settings" Click="OnSaveClicked" Background="{StaticResource FreelyAccentBrush}" Foreground="White" />
                <Button Content="Test connection" Click="OnTestConnectionClicked" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
